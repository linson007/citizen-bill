{
  "name": "mattamundo",
  "version": "0.1.0",
  "private": true,
  "description": "MattamUndo (മാറ്റം ഉണ്ടോ?) — open-source civic platform for drafting, discussing, and supporting public bill proposals with AI assistance.",
  "license": "MIT",
  "homepage": "https://mattamundo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linson007/citizen-bill.git"
  },
  "bugs": {
    "url": "https://github.com/linson007/citizen-bill/issues"
  },
  "keywords": [
    "civic-tech",
    "legislation",
    "mattamundo",
    "open-source",
    "nextjs",
    "kerala",
    "undo-universe",
    "public-participation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/vercel-migrate.mjs && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.3.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.12",
    "next-auth": "^4.24.14",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
