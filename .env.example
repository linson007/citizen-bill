# Local database connection used by Prisma.
# Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://citizen_bill:citizen_bill_password@localhost:5432/citizen_bill?schema=public"

# NextAuth/Auth.js configuration.
# Generate a local secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI is optional in development. If omitted, the app returns deterministic fallback AI drafts.
OPENAI_API_KEY=""
# Optional: override the OpenAI chat/completions model. Defaults to gpt-4.1-mini.
OPENAI_MODEL="gpt-4.1-mini"

# Optional: override the default per-user daily AI limit. Default is 20.
AI_DAILY_LIMIT="20"

# Optional: required only when enabling Vercel Blob uploads for bill attachments.
BLOB_READ_WRITE_TOKEN=""

# Optional: email sender identity. Delivery is not implemented yet; when set,
# notification events are logged as queued-not-sent instead of using a provider.
EMAIL_FROM=""
