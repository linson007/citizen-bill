# PostgreSQL connection used by Prisma at runtime.
# Local Docker (matches docker-compose.yml):
DATABASE_URL="postgresql://citizen_bill:citizen_bill_password@localhost:5432/citizen_bill?schema=public"
# Supabase on Vercel: use the Transaction pooler (port 6543), not Session (5432).
# Session mode is capped (~15 clients) and will 500 under serverless load with:
#   (EMAXCONNSESSION) max clients reached in session mode
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct/session URL for prisma migrate (required on Vercel if DATABASE_URL uses pgbouncer).
# Prefer db.PROJECT_REF.supabase.co:5432, or the pooler session port 5432.
# Local Docker can omit this (migrate falls back to DATABASE_URL).
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# NextAuth/Auth.js configuration.
# Generate a local secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Must include the protocol (https:// in production). Bare hosts also work via getAppUrl().
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI is optional in development. If omitted, the app returns deterministic fallback AI drafts.
OPENAI_API_KEY=""
# Optional: override the OpenAI chat/completions model. Defaults to gpt-4.1-mini.
OPENAI_MODEL="gpt-4.1-mini"

# Optional: override the default per-user daily AI limit. Default is 20.
AI_DAILY_LIMIT="20"

# Optional: required only when enabling Vercel Blob uploads for bill attachments.
BLOB_READ_WRITE_TOKEN=""

# Optional: email sender identity. Delivery is not implemented yet; when set,
# notification events are logged as queued-not-sent instead of using a provider.
EMAIL_FROM=""
